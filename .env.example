# Sentinel Drone Pipeline — Environment Variables
# Copy to .env and fill in values (or set as system environment variables)

# Supabase (required for database operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# Google Drive (required for delivery upload)
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# OpenAI (required for Path E vegetation analysis — species classification, health assessment)
OPENAI_API_KEY=sk-...

# PlantNet (required for Path E species cross-validation)
PLANTNET_API_KEY=your-plantnet-api-key

# n8n Webhook (optional — defaults to localhost)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ingest
